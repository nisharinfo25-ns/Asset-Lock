# ================================================================
# AssetLock — Decentralized IAM — Environment Configuration
# Copy this file to .env and fill in your values.
# ================================================================

# Server
PORT=5000

# MongoDB (optional — falls back to JSON database automatically)
MONGODB_URI=mongodb://localhost:27017/secure_assets

# JWT Secret — change this to a long random string in production
JWT_SECRET=AssetLock_SECURE_JWT_SIGNING_KEY_2026_CHANGE_IN_PRODUCTION

# Blockchain (optional — falls back to deterministic simulation automatically)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Pinata IPFS (optional — falls back to local content-addressed store automatically)
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Frontend (Vite)
VITE_API_URL=http://localhost:5000/api
